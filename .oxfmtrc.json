{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "never",
  "jsdoc": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/.vite/**",
    "**/.tmp-*",
    "**/.tmp-*/**",
    "**/*.tsbuildinfo",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "docs/benchmarks.md",
    "packages/examples/**"
  ]
}
