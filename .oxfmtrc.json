{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 64,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "always",
  "jsdoc": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/.vite/**",
    "**/*.tsbuildinfo",
    "bun.lock",
    "examples/**"
  ]
}
