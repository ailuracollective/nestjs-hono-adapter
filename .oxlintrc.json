{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": ["jsx", "tsx"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/jsx-max-depth": [
      "error",
      {
        "max": 5
      }
    ],
    "no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1],
        "ignoreArrayIndexes": true
      }
    ],
    "one-var": ["error", "never"],
    "capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 400
      }
    ],
    "no-undefined": "off",
    "no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "promise-function-async": "off",
    "prefer-readonly-parameter-types": "off",
    "sort-imports": "off"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "packages/*/src/**/*.ts",
        "packages/*/test/**/*.ts"
      ],
      "env": {
        "builtin": true,
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        "new-cap": "off",
        "oxc/no-async-await": "off",
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowWithDecorator": true
          }
        ]
      }
    },
    {
      "files": ["src/**/*.ts", "packages/*/src/**/*.ts"],
      "rules": {
        "class-methods-use-this": "off",
        "promise/prefer-await-to-callbacks": "off"
      }
    },
    {
      "files": [
        "src/*/index.ts",
        "packages/*/src/index.ts",
        "packages/*/index.ts"
      ],
      "rules": {
        "oxc/no-barrel-file": "off"
      }
    },
    {
      "files": ["test/**/*.ts", "packages/*/test/**/*.ts"],
      "rules": {
        "class-methods-use-this": "off",
        "import/max-dependencies": [
          "error",
          {
            "max": 20
          }
        ],
        "import/no-relative-parent-imports": "off",
        "import/no-unassigned-import": "off",
        "max-classes-per-file": "off"
      }
    },
    {
      "files": [
        "src/core/response-helpers.ts",
        "src/core/versioned-route.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/core/server-adapter.ts"],
      "rules": {
        "import/max-dependencies": [
          "error",
          {
            "max": 14
          }
        ],
        "prefer-object-spread": "off"
      }
    },
    {
      "files": [
        "packages/ws/src/client.ts",
        "packages/ws/src/server.ts",
        "src/core/bindings.ts",
        "src/servers/bun.ts",
        "src/servers/node.ts",
        "src/servers/fetch.ts"
      ],
      "rules": {
        "unicorn/prefer-event-target": "off"
      }
    },
    {
      "files": [
        "src/core/hono-lifecycle.ts",
        "src/core/request.ts",
        "src/features/static-assets.ts",
        "src/servers/bun.ts",
        "src/servers/node.ts",
        "packages/ws/src/adapter.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": [
        "src/servers/bun.ts",
        "src/servers/node.ts",
        "packages/ws/src/adapter.ts"
      ],
      "rules": {
        "import/max-dependencies": [
          "error",
          {
            "max": 12
          }
        ]
      }
    },
    {
      "files": ["packages/ws/src/adapter.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 450
          }
        ]
      }
    },
    {
      "files": [
        "src/core/server-adapter.ts",
        "src/servers/bun.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 450
          }
        ]
      }
    },
    {
      "files": ["src/servers/node.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["test/bun-adapter.ts"],
      "rules": {
        "prefer-object-spread": "off"
      }
    },
    {
      "files": ["src/core/bindings.ts"],
      "rules": {
        "max-classes-per-file": "off"
      }
    },
    {
      "files": [
        "src/core/**/*.ts",
        "src/features/**/*.ts",
        "src/servers/**/*.ts",
        "packages/ws/src/**/*.ts"
      ],
      "rules": {
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": ["test/**/*.ts", "packages/*/test/**/*.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 700,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": ["src/core/request.ts"],
      "rules": {
        "oxc/no-optional-chaining": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["test/config.test.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "test/config-fixture.ts",
        "test/cqrs.test.ts",
        "test/event-emitter.test.ts",
        "test/jwt.test.ts",
        "test/schedule.test.ts",
        "test/terminus.test.ts"
      ],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["src/core/hono-lifecycle.ts"],
      "rules": {
        "import/max-dependencies": [
          "error",
          {
            "max": 12
          }
        ]
      }
    },
    {
      "files": ["src/features/sse.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/multipart/index.ts"],
      "rules": {
        "import/group-exports": "off"
      }
    },
    {
      "files": [
        "src/multipart/interceptors/any-files.interceptor.ts",
        "src/multipart/interceptors/file-fields.interceptor.ts",
        "src/multipart/interceptors/file.interceptor.ts",
        "src/multipart/interceptors/no-files.interceptor.ts"
      ],
      "rules": {
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": [
        "src/multipart/interceptors/files.interceptor.ts"
      ],
      "rules": {
        "import/no-relative-parent-imports": "off",
        "oxc/no-rest-spread-properties": "off"
      }
    },
    {
      "files": ["src/multipart/multipart/append-field.util.ts"],
      "rules": {
        "init-declarations": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-continue": "off",
        "no-magic-numbers": "off",
        "no-ternary": "off",
        "oxc/no-optional-chaining": "off",
        "prefer-named-capture-group": "off",
        "sort-keys": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/switch-case-braces": "off"
      }
    },
    {
      "files": [
        "src/multipart/multipart/multipart.constants.ts"
      ],
      "rules": {
        "sort-keys": "off"
      }
    },
    {
      "files": [
        "src/multipart/multipart/multipart.interceptor.factory.ts"
      ],
      "rules": {
        "import/max-dependencies": "off",
        "import/no-relative-parent-imports": "off",
        "max-classes-per-file": "off",
        "oxc/no-optional-chaining": "off"
      }
    },
    {
      "files": ["src/multipart/multipart/multipart.parser.ts"],
      "rules": {
        "import/max-dependencies": "off",
        "import/no-relative-parent-imports": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-continue": "off",
        "no-ternary": "off",
        "no-underscore-dangle": "off",
        "oxc/no-optional-chaining": "off",
        "prefer-object-spread": "off",
        "promise/always-return": "off",
        "promise/avoid-new": "off",
        "promise/prefer-await-to-then": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "unicorn/no-useless-switch-case": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/switch-case-braces": "off"
      }
    },
    {
      "files": ["src/multipart/multipart/multipart.utils.ts"],
      "rules": {
        "import/no-relative-parent-imports": "off",
        "max-statements": "off",
        "no-ternary": "off",
        "oxc/no-rest-spread-properties": "off"
      }
    },
    {
      "files": ["src/multipart/storage/disk.storage.ts"],
      "rules": {
        "import/no-relative-parent-imports": "off",
        "init-declarations": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "node/callback-return": "off",
        "node/no-sync": "off",
        "prefer-destructuring": "off",
        "promise/avoid-new": "off",
        "typescript/explicit-function-return-type": "off",
        "typescript/no-misused-promises": "off",
        "typescript/strict-void-return": "off",
        "unicorn/no-null": "off",
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      "files": ["src/multipart/storage/memory.storage.ts"],
      "rules": {
        "import/no-relative-parent-imports": "off",
        "unicorn/no-null": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/.vite/**",
    "**/*.tsbuildinfo",
    "bun.lock",
    "examples/**"
  ]
}
