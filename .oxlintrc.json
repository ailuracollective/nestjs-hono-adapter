{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1],
        "ignoreArrayIndexes": true
      }
    ],
    "one-var": ["error", "never"],
    "curly": "off",
    "capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 400
      }
    ],
    "no-undefined": "off",
    "no-ternary": "off",
    "no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "promise-function-async": "off",
    "prefer-readonly-parameter-types": "off",
    "sort-imports": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "test/**/*.ts", "packages/*/src/**/*.ts", "packages/*/test/**/*.ts"],
      "env": {
        "builtin": true,
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off",
        "new-cap": "off",
        "oxc/no-async-await": "off",
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowWithDecorator": true
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "class-methods-use-this": "off",
        "promise/prefer-await-to-callbacks": "off"
      }
    },
    {
      "files": ["test/**/*.ts", "packages/*/test/**/*.ts"],
      "rules": {
        "class-methods-use-this": "off",
        "import/max-dependencies": [
          "error",
          {
            "max": 20
          }
        ],
        "import/no-unassigned-import": "off",
        "max-classes-per-file": "off",
        "max-lines": [
          "error",
          {
            "max": 700,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": [
        "packages/core/src/core/response/response-helpers.ts",
        "packages/core/src/core/route/versioned-route.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/core/src/core/server/server-adapter.ts"],
      "rules": {
        "import/max-dependencies": [
          "error",
          {
            "max": 15
          }
        ],
        "max-lines": [
          "error",
          {
            "max": 450
          }
        ],
        "prefer-object-spread": "off"
      }
    },
    {
      "files": ["test/bun-adapter.ts"],
      "rules": {
        "prefer-object-spread": "off"
      }
    },
    {
      "files": ["packages/core/src/core/server/hono-lifecycle.ts"],
      "rules": {
        "import/max-dependencies": [
          "error",
          {
            "max": 13
          }
        ],
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": [
        "packages/core/src/core/ports/bindings.ts",
        "packages/core/src/servers/bun/**/*.ts",
        "packages/core/src/servers/node.ts",
        "packages/core/src/servers/fetch.ts"
      ],
      "rules": {
        "unicorn/prefer-event-target": "off"
      }
    },
    {
      "files": [
        "packages/core/src/core/request/request.ts",
        "packages/core/src/features/static-assets/**/*.ts",
        "packages/core/src/servers/bun-runtime.ts",
        "packages/core/src/servers/bun/**/*.ts",
        "packages/core/src/servers/node.ts",
        "packages/socket-io/src/patch.ts",
        "packages/ws/src/patch.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/core/src/core/ports/bindings.ts"],
      "rules": {
        "max-classes-per-file": "off"
      }
    },
    {
      "files": [
        "packages/core/src/core/request/bag-state.ts",
        "packages/core/src/core/request/request.ts"
      ],
      "rules": {
        "oxc/no-optional-chaining": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["packages/core/test/config.test.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "packages/core/test/config-fixture.ts",
        "packages/core/test/config-fixture/**/*.ts",
        "packages/core/test/cqrs.test.ts",
        "packages/core/test/event-emitter.test.ts",
        "packages/core/test/jwt.test.ts",
        "packages/core/test/schedule.test.ts",
        "packages/core/test/terminus.test.ts"
      ],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["packages/core/src/features/sse.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/multipart/src/index.ts"],
      "rules": {
        "import/group-exports": "off"
      }
    },
    {
      "files": ["packages/multipart/src/interceptors/files.interceptor.ts"],
      "rules": {
        "oxc/no-rest-spread-properties": "off"
      }
    },
    {
      "files": ["packages/multipart/src/multipart/append-field.util.ts"],
      "rules": {
        "init-declarations": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-continue": "off",
        "no-magic-numbers": "off",
        "oxc/no-optional-chaining": "off",
        "prefer-named-capture-group": "off",
        "sort-keys": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/switch-case-braces": "off"
      }
    },
    {
      "files": ["packages/multipart/src/multipart/multipart.constants.ts"],
      "rules": {
        "sort-keys": "off"
      }
    },
    {
      "files": ["packages/multipart/src/multipart/multipart.interceptor.factory.ts"],
      "rules": {
        "max-classes-per-file": "off",
        "oxc/no-optional-chaining": "off"
      }
    },
    {
      "files": ["packages/graphql/src/apollo-subscription-route.ts"],
      "rules": {
        "oxc/no-rest-spread-properties": "off"
      }
    },
    {
      "files": ["packages/multipart/src/multipart/multipart.parser*.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-continue": "off",
        "no-underscore-dangle": "off",
        "oxc/no-optional-chaining": "off",
        "prefer-object-spread": "off",
        "promise/always-return": "off",
        "promise/avoid-new": "off",
        "promise/prefer-await-to-then": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "unicorn/no-useless-switch-case": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/switch-case-braces": "off"
      }
    },
    {
      "files": ["packages/multipart/src/multipart/multipart.utils.ts"],
      "rules": {
        "max-statements": "off",
        "oxc/no-rest-spread-properties": "off"
      }
    },
    {
      "files": ["packages/socket-io/src/engine.ts"],
      "rules": {
        "oxc/no-optional-chaining": "off"
      }
    },
    {
      "files": [
        "packages/core/src/compat/**/*.ts",
        "packages/graphql/src/**/*.ts",
        "packages/serve-static/src/**/*.ts",
        "packages/socket-io/src/**/*.ts",
        "packages/ws/src/**/*.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 100,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/compat/express/middleware-fit.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/.tmp-*",
    "**/.tmp-*/**",
    "**/*.tsbuildinfo",
    "bun.lock",
    "examples/**"
  ]
}
