{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    /**
     * The adapter is aliased to the repository source, and the
     * transport under the `/servers/*` specifier
     * `wrangler.jsonc` uses, so the example runs from a fresh clone
     * with no build step. The paths are relative to this file.
     */
    "paths": {
      "@ailura/nestjs-hono-adapter": ["../../../src/index.ts"],
      "@ailura/nestjs-hono-adapter/servers/fetch": ["../../../src/servers/fetch.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
