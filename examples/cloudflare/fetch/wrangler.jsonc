{
  "name": "ailura-nestjs-hono-fetch",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "define": {
    "import.meta.url": "\"file:///worker.js\""
  },
  // The adapter is aliased to the repository source, and each
  // transport under the `/servers/*` specifier this repository uses
  // for it, so a folder here runs from a fresh clone with no build
  // step: nothing below resolves through `dist/`.
  //
  // What a real project writes is in `examples/README.md` — the
  // published subpath, `./fetch` and its siblings, which the
  // `exports` map answers. These folders do not import those names,
  // and the gap is deliberate: the aliases stand in for an install
  // that has not happened yet, and they are the only reason
  // `/servers/*` resolves at all, since no install ever would.
  //
  // The bare name is aliased alongside them, because the transports
  // reach back into `core/` by relative path. Without it, the
  // application would arrive from `dist/` and its transport from
  // `src/`, and the bundle would hold two copies of the same code.
  //
  // What is left is what a real project does copy: the optional
  // peers below, aliased to a module with nothing in it, because the
  // bundler resolves them on the way to the branches this Worker
  // never takes. See `src/stub-optional-peers.ts`.
  "alias": {
    "@ailura/nestjs-hono-adapter": "../../../src/index.ts",
    "@ailura/nestjs-hono-adapter/servers/fetch": "../../../src/servers/fetch.ts",
    "@fastify/static": "./src/stub-optional-peers.ts",
    "@nestjs/platform-express": "./src/stub-optional-peers.ts",
    "@nestjs/platform-socket.io": "./src/stub-optional-peers.ts",
    "@nats-io/transport-node": "./src/stub-optional-peers.ts",
    "amqp-connection-manager": "./src/stub-optional-peers.ts",
    "class-transformer": "./src/stub-optional-peers.ts",
    "class-validator": "./src/stub-optional-peers.ts",
    "ioredis": "./src/stub-optional-peers.ts",
    "kafkajs": "./src/stub-optional-peers.ts",
    "mqtt": "./src/stub-optional-peers.ts"
  },
  "previews": {}
}
