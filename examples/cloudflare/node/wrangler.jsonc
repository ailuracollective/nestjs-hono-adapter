{
  "name": "ailura-nestjs-hono",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules",
    "enable_request_signal"
  ],
  // `@nestjs/swagger` calls `createRequire(import.meta.url)` at
  // module load; `import.meta.url` is undefined under workerd, which
  // makes `createRequire` throw. A defined value keeps the call
  // valid; the UI path (`getSwaggerAssetsAbsoluteFSPath`) is never
  // reached because the example only builds the document and hands
  // it to Scalar, which serves its page from a CDN.
  "define": {
    "import.meta.url": "\"file:///worker.js\""
  },
  // The adapter is deliberately absent from this block. A real
  // project installs `@ailura/nestjs-hono-adapter` and imports it, and
  // its subpaths, by name — and resolution here takes that same road:
  // `node_modules` holds the workspace root, whose `exports` answer
  // with `dist/`. An entry pointing at `src/` would be a path only
  // this repository has, and would hide the very thing an example is
  // for, which is that the published subpaths resolve.
  //
  // What is left is the part a real project does copy: the optional
  // peers below, aliased to a module with nothing in it, because the
  // bundler resolves them on the way to the branches this Worker
  // never takes. See `src/stub-optional-peers.ts`.
  "alias": {
    "@fastify/static": "./src/stub-optional-peers.ts",
    "@nestjs/platform-express": "./src/stub-optional-peers.ts",
    "@nestjs/platform-socket.io": "./src/stub-optional-peers.ts",
    "@nats-io/transport-node": "./src/stub-optional-peers.ts",
    "amqp-connection-manager": "./src/stub-optional-peers.ts",
    "class-transformer": "./src/stub-optional-peers.ts",
    "class-validator": "./src/stub-optional-peers.ts",
    "ioredis": "./src/stub-optional-peers.ts",
    "kafkajs": "./src/stub-optional-peers.ts",
    "mqtt": "./src/stub-optional-peers.ts"
  },
  // Worker Previews require the block. It can be empty: this
  // harness has no Preview-specific settings.
  "previews": {}
}
