{
  "name": "ailura-nestjs-hono",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules",
    "enable_request_signal"
  ],
  "define": {
    "import.meta.url": "\"file:///worker.js\""
  },
  "alias": {
    "@ailura/nestjs-hono-adapter": "../../../src/index.ts",
    "@ailura/nestjs-hono-adapter/servers/node": "../../../src/servers/node.ts",
    "@fastify/static": "./src/stub-optional-peers.ts",
    "@nestjs/platform-express": "./src/stub-optional-peers.ts",
    "@nestjs/platform-socket.io": "./src/stub-optional-peers.ts",
    "@nats-io/transport-node": "./src/stub-optional-peers.ts",
    "amqp-connection-manager": "./src/stub-optional-peers.ts",
    "class-transformer": "./src/stub-optional-peers.ts",
    "class-validator": "./src/stub-optional-peers.ts",
    "ioredis": "./src/stub-optional-peers.ts",
    "kafkajs": "./src/stub-optional-peers.ts",
    "mqtt": "./src/stub-optional-peers.ts"
  },
  "previews": {}
}
