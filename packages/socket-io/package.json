{
  "name": "@ailura/nestjs-hono-adapter-socket-io",
  "version": "1.4.1",
  "description": "Socket.IO gateway adapter for @ailura/nestjs-hono-adapter.",
  "keywords": [
    "adapter",
    "hono",
    "nestjs",
    "socket.io"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11 <13",
    "@nestjs/websockets": ">=11 <13",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
