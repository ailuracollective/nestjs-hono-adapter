{
  "name": "@ailura/nestjs-hono-adapter-multipart",
  "version": "1.4.1",
  "description": "The upload island of @ailura/nestjs-hono-adapter: multer-shaped multipart parsing, in its own package.",
  "keywords": [
    "adapter",
    "hono",
    "multipart",
    "nestjs",
    "upload"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.compat.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@ailura/nestjs-hono-adapter": ">=1.4.1 <2",
    "@nestjs/common": ">=11 <13",
    "busboy": "^1.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
