{
  "name": "@ailura/nestjs-platform-hono-multipart",
  "version": "0.1.0",
  "description": "The upload island of @ailura/nestjs-hono-adapter: multer-shaped multipart parsing, in its own package.",
  "keywords": [
    "adapter",
    "hono",
    "multipart",
    "nestjs",
    "upload"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#multipart/*": "./dist/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist *.tsbuildinfo && bun run build",
    "size": "size-limit",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@ailura/nestjs-hono-adapter": ">=1.4.1 <2 || >=1.4.2-beta <2 || >=1.5.0-beta <2",
    "@nestjs/common": ">=11 <13",
    "busboy": "^1.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
