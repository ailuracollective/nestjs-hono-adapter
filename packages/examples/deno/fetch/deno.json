{
  "imports": {
    "@ailura/nestjs-hono-adapter": "npm:@ailura/nestjs-hono-adapter@^1.4.1",
    "@ailura/nestjs-hono-adapter/fetch": "npm:@ailura/nestjs-hono-adapter@^1.4.1/fetch",
    "@ailura/nestjs-hono-adapter/node-server": "npm:@ailura/nestjs-hono-adapter@^1.4.1/node-server",
    "reflect-metadata": "npm:reflect-metadata",
    "@nestjs/common": "npm:@nestjs/common",
    "@nestjs/core": "npm:@nestjs/core",
    "@nestjs/swagger": "npm:@nestjs/swagger",
    "@scalar/nestjs-api-reference": "npm:@scalar/nestjs-api-reference",
    "hono": "npm:hono",
    "@hono/node-server": "npm:@hono/node-server",
    "rxjs": "npm:rxjs"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env src/main.ts",
    "start": "deno run --allow-net --allow-env src/main.ts"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true
  }
}
