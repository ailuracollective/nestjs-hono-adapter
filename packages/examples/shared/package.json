{
  "name": "@ailura/examples-shared",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/inertia/dev.d.ts",
      "default": "./dist/inertia/dev.js"
    },
    "./app": {
      "types": "./dist/app/app.module.d.ts",
      "default": "./dist/app/app.module.js"
    }
  },
  "scripts": {
    "build": "bun run build:client && tsc -p tsconfig.build.json",
    "build:client": "vite build && bun run ../../../scripts/inline-inertia.ts ."
  },
  "dependencies": {
    "@ailura/nestjs-hono-adapter": "workspace:*",
    "@dudousxd/nestjs-inertia": "3.0.1",
    "@dudousxd/nestjs-inertia-vite": "3.0.1",
    "@inertiajs/react": "^3.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/swagger": "12.0.2",
    "@scalar/nestjs-api-reference": "1.2.28",
    "hono": "^4.13.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
