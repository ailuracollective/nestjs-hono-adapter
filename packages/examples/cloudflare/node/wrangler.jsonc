{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "ailura-nestjs-hono-node",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules",
    "enable_request_signal"
  ],
  "define": {
    "import.meta.url": "\"file:///worker.js\"",
    "process.env.INERTIA_HOST": "\"workers\"",
    "process.env.INERTIA_SHELL": "\"shim\"",
    "process.env.NODE_ENV": "\"production\""
  },
  "alias": {
    "@ailura/examples-shared": "../../shared/src/index.ts",
    "@ailura/examples-shared/dev": "../../shared/src/inertia/dev.ts",
    "@ailura/nestjs-hono-adapter": "../../../../packages/core/src/index.ts",
    "@ailura/nestjs-hono-adapter/node-server": "../../../../packages/core/src/servers/node.ts",
    "@ailura/nestjs-platform-hono-inertia": "../../../../packages/inertia/src/index.ts",
    "@ailura/nestjs-platform-hono-inertia/register": "../../../../packages/inertia/src/register.ts",
    "@fastify/static": "./src/stub-optional-peers.ts",
    "fs": "./src/fs-shim.ts",
    "fs/promises": "./src/fs-shim.ts",
    "@nestjs/microservices": "./src/stub-optional-peers.ts",
    "@nestjs/microservices/microservices-module.js": "./src/stub-optional-peers.ts",
    "@nestjs/websockets/socket-module.js": "./src/stub-optional-peers.ts",
    "@nestjs/platform-express": "./src/stub-optional-peers.ts",
    "@nestjs/platform-socket.io": "./src/stub-optional-peers.ts",
    "@nats-io/transport-node": "./src/stub-optional-peers.ts",
    "amqp-connection-manager": "./src/stub-optional-peers.ts",
    "class-transformer": "./src/stub-optional-peers.ts",
    "class-validator": "./src/stub-optional-peers.ts",
    "ioredis": "./src/stub-optional-peers.ts",
    "kafkajs": "./src/stub-optional-peers.ts",
    "mqtt": "./src/stub-optional-peers.ts",
    "node:module": "./src/stub-node-module.ts"
  },
  "previews": {}
}
