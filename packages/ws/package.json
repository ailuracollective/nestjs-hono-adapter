{
  "name": "@ailura/nestjs-hono-adapter-ws",
  "version": "1.4.1",
  "description": "WebSocket gateway adapter for @ailura/nestjs-hono-adapter.",
  "keywords": [
    "adapter",
    "hono",
    "nestjs",
    "websockets"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.compat.json",
    "prepack": "rm -rf dist *.tsbuildinfo && bun run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@ailura/nestjs-hono-adapter-core": ">=1.4.1 <2",
    "@hono/node-ws": "^1.3.1",
    "@nestjs/common": ">=11 <13",
    "@nestjs/websockets": ">=11 <13",
    "hono": "^4.13.8",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@ailura/nestjs-hono-adapter-core": {
      "optional": true
    },
    "@hono/node-ws": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
