{
  "name": "@ailura/nestjs-platform-hono-serve-static",
  "version": "1.4.1",
  "description": "The static-asset bridge of @ailura/nestjs-hono-adapter: @nestjs/serve-static reading through the transport, in its own package.",
  "keywords": [
    "adapter",
    "hono",
    "nestjs",
    "serve-static",
    "static"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#serve-static/*": "./dist/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist *.tsbuildinfo && bun run build",
    "size": "size-limit",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@ailura/nestjs-hono-adapter": ">=1.4.1 <2",
    "@nestjs/serve-static": ">=11 <13"
  },
  "peerDependenciesMeta": {
    "@nestjs/serve-static": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
