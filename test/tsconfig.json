{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "types": ["node", "bun"],
    "paths": {
      "#adapter/*": ["../packages/core/src/*.ts", "../packages/core/src/*"],
      "#adapter-test/*": ["../packages/core/test/*.ts", "../packages/core/test/*"],
      "#multipart/*": ["../packages/multipart/src/*.ts", "../packages/multipart/src/*"],
      "#multipart-test/*": ["../packages/multipart/test/*.ts", "../packages/multipart/test/*"],
      "#serve-static/*": ["../packages/serve-static/src/*.ts", "../packages/serve-static/src/*"],
      "#serve-static-test/*": [
        "../packages/serve-static/test/*.ts",
        "../packages/serve-static/test/*"
      ],
      "#ws/*": ["../packages/ws/src/*.ts", "../packages/ws/src/*"],
      "#test/*": ["./*.ts", "./*"],
      "#root/*": ["../*"],
      "#benchmarks/*": ["../packages/benchmarks/src/*.ts", "../packages/benchmarks/src/*"],
      "#compat-test/*": ["../packages/compatibility/test/*.ts", "../packages/compatibility/test/*"],
      "@ailura/nestjs-hono-adapter": ["../packages/core/src/index.ts"],
      "@ailura/nestjs-hono-adapter/bun-server": ["../packages/core/src/servers/bun.ts"],
      "@ailura/nestjs-hono-adapter/node-server": ["../packages/core/src/servers/node.ts"],
      "@ailura/nestjs-hono-adapter/fetch": ["../packages/core/src/servers/fetch.ts"],
      "@ailura/nestjs-platform-hono-multipart": ["../packages/multipart/src/index.ts"],
      "@ailura/nestjs-platform-hono-serve-static": ["../packages/serve-static/src/index.ts"],
      "@ailura/nestjs-platform-hono-socket-io": ["../packages/socket-io/src/index.ts"],
      "@ailura/nestjs-platform-hono-ws": ["../packages/ws/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "../packages/*/src/**/*.ts", "../packages/*/test/**/*.ts"]
}
