{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "types": ["node", "bun"],
    "paths": {
      "#adapter/*": [
        "../packages/core/src/*.ts",
        "../packages/core/src/*"
      ],
      "#adapter-test/*": [
        "../packages/core/test/*.ts",
        "../packages/core/test/*"
      ],
      "#multipart/*": [
        "../packages/multipart/src/*.ts",
        "../packages/multipart/src/*"
      ],
      "#multipart-test/*": [
        "../packages/multipart/test/*.ts",
        "../packages/multipart/test/*"
      ],
      "#ws/*": [
        "../packages/ws/src/*.ts",
        "../packages/ws/src/*"
      ],
      "#socket-io/*": [
        "../packages/socket-io/src/*.ts",
        "../packages/socket-io/src/*"
      ],
      "#test/*": ["./*.ts", "./*"],
      "#root/*": ["../*"],
      "@ailura/nestjs-hono-adapter": [
        "../packages/core/src/index.ts"
      ],
      "@ailura/nestjs-hono-adapter/bun-server": [
        "../packages/core/src/servers/bun.ts"
      ],
      "@ailura/nestjs-hono-adapter/node-server": [
        "../packages/core/src/servers/node.ts"
      ],
      "@ailura/nestjs-hono-adapter/fetch": [
        "../packages/core/src/servers/fetch.ts"
      ],
      "@ailura/nestjs-platform-hono-multipart": [
        "../packages/multipart/src/index.ts"
      ],
      "@ailura/nestjs-platform-hono-socket-io": [
        "../packages/socket-io/src/index.ts"
      ],
      "@ailura/nestjs-platform-hono-ws": [
        "../packages/ws/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../packages/*/src/**/*.ts",
    "../packages/*/test/**/*.ts"
  ]
}
