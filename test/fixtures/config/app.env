# The environment file the cases that read a plain one name.
#
# `@nestjs/config` is pointed at these through `envFilePath`, and a
# case that did not name one would have the module read whatever
# `.env` sits in the working directory — which is whatever the
# developer happens to have. Naming the file is also what keeps one
# case's variables from being another's: `forRoot` writes what it
# loads into `process.env`, so two cases sharing a name would see
# whichever loaded last.

APP_NAME=hono-adapter-fixture
APP_PORT=8080