{
  "private": true,
  "workspaces": [
    "examples/cloudflare/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bench": "bun run build:core && bun run --filter @ailura/nestjs-hono-adapter-benchmarks bench",
    "build": "bun run build:core && bun run build:packages",
    "build:core": "bun run --filter @ailura/nestjs-hono-adapter build",
    "build:packages": "bun run --filter @ailura/nestjs-platform-hono-socket-io --filter @ailura/nestjs-platform-hono-ws --filter @ailura/nestjs-platform-hono-multipart build",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run size",
    "clean": "rm -rf dist *.tsbuildinfo packages/*/dist packages/*/*.tsbuildinfo",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "size": "bun run build && bun run --filter './packages/*' size",
    "test": "bun run build:core && bun test",
    "typecheck": "bun run build:core && tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.3",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "^12.0.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@socket.io/bun-engine": "0.1.2",
    "@types/bun": "^1.4.2",
    "@types/busboy": "1.5.5",
    "@types/node": "^22.20.3",
    "@types/passport-jwt": "4.0.1",
    "@types/ws": "8.18.2",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "hono": "^4.13.8",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "size-limit": "^14.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^7.0.2",
    "wrangler": "4.136.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
