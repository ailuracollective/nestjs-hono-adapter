{
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/examples/cloudflare/*",
    "packages/examples/docker/*",
    "packages/examples/google/*",
    "packages/examples/vercel/*"
  ],
  "type": "module",
  "scripts": {
    "bench": "bun run build:core && bun run --filter @ailura/nestjs-hono-adapter-benchmarks bench",
    "build": "bun run build:core && bun run build:packages",
    "build:core": "bun run --filter @ailura/nestjs-hono-adapter build",
    "build:packages": "bun run --filter @ailura/nestjs-platform-hono-socket-io --filter @ailura/nestjs-platform-hono-ws --filter @ailura/nestjs-platform-hono-multipart --filter @ailura/nestjs-platform-hono-graphql --filter @ailura/nestjs-platform-hono-serve-static build",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run size",
    "clean": "rm -rf dist *.tsbuildinfo packages/*/dist packages/*/*.tsbuildinfo",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "size": "bun run build && bun run --filter './packages/*' size",
    "test": "bun run build && bun test",
    "typecheck": "bun run build:core && tsc -p test/tsconfig.json",
    "ignore-build": "bun run scripts/ignore-build.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "hono": "4.13.13",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apollo/server": "5",
    "@cloudflare/workers-types": "5.20260922.1",
    "@hono/node-server": "2.1.5",
    "@hono/node-ws": "1.3.1",
    "@nestjs/apollo": "14",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/platform-ws": "12.1.3",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/websockets": "12.1.3",
    "@size-limit/preset-small-lib": "14.2.0",
    "@socket.io/bun-engine": "0.1.2",
    "@types/bun": "1.4.3",
    "@types/busboy": "1.5.5",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "busboy": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ejs": "7.0.1",
    "graphql": "16",
    "graphql-ws": "6.3.0",
    "hono": "4.13.13",
    "oxfmt": "0.68.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "size-limit": "14.2.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2",
    "wrangler": "4.136.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
