{
  "name": "@ailura/nestjs-hono-adapter",
  "version": "1.1.0",
  "description": "NestJS HTTP adapter that runs an application on Hono.",
  "keywords": [
    "adapter",
    "hono",
    "http",
    "nestjs",
    "node"
  ],
  "homepage": "https://github.com/ailuracollective/nestjs-hono-adapter#readme",
  "bugs": {
    "url": "https://github.com/ailuracollective/nestjs-hono-adapter/issues"
  },
  "license": "MIT",
  "author": "Ailura Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailuracollective/nestjs-hono-adapter.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepack": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/websockets": "^12.0.3",
    "@semantic-release/changelog": "^7",
    "@semantic-release/git": "^11",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "hono": "^4.13.8",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semantic-release": "^25",
    "typescript": "^7.0.2",
    "wrangler": "4.136.2"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@nestjs/common": ">=11 <13",
    "@nestjs/core": ">=11 <13",
    "@nestjs/websockets": ">=11 <13",
    "hono": "^4.13.8"
  },
  "peerDependenciesMeta": {
    "@hono/node-ws": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
